      "id": "sp-p",
      "r": 0,
      "c": 0,
      "recipe": [
        {
          "t": "sī",
          "role": "signal"
        },
        {
          "t": "present indicative",
          "role": "verb"
        }
      ],
      "tell": "sī + present indicative — a plain fact, no comment on its truth",
      "freqTier": 1,
      "requires": [
        "verb.laudo.pres.act.ind"
      ],
      "examples": [
        {
          "id": "sp1",
          "pieces": [
            {
              "t": "Sī",
              "role": "signal"
            },
            {
              "t": "id",
              "role": "plain"
            },
            {
              "t": "facit",
              "role": "verb"
            },
            {
              "t": ", errat.",
              "role": "plain"
            }
          ],
          "translation": "If he is doing it, he is making a mistake.",
          "source": "Wheelock 33 (pattern sentence)",
          "fakes": [
            {
              "pieceIdx": 2,
              "t": "faciat",
              "fromCell": "flv-p",
              "teaches": "faciat is present SUBJUNCTIVE — that makes it future-less-vivid ('should he do it'), not a simple fact.",
              "checked": true
            }
          ]
        }
      ]
    },
