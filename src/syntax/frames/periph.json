          "role": "verb"
        },
        {
          "t": "sum",
          "role": "signal"
        }
      ],
      "tell": "gerundive + a form of sum = 'must be …-ed', 'ought to be …-ed'",
      "freqTier": 1,
      "requires": [
        "verb.laudo.periph.pass"
      ],
      "examples": [
        {
          "id": "pp1",
          "pieces": [
            {
              "t": "Urbs",
              "role": "plain"
