{
  "id": "cum",
  "label": "Cum-clauses — one word, four jobs",
  "short": "Cum",
  "taughtAt": 31,
  "layout": {
    "rowLabels": [
      "Temporal",
      "Circumstantial",
      "Causal",
      "Concessive"
    ],
    "colLabels": [
      "mood + sense"
    ]
  },
  "notes": "cum + INDICATIVE means only 'when'. cum + SUBJUNCTIVE opens three doors — circumstantial, causal ('since'), concessive ('although', usually with tamen in the main clause) — and only sense decides between them. Learn the mood split first; the three subjunctive senses come with reading.",
  "cells": [
    {
      "id": "temporal",
      "r": 0,
      "c": 0,
      "recipe": [
        {
          "t": "cum",
          "role": "signal"
        },
        {
          "t": "indicative",
          "role": "verb"
        }
      ],
      "tell": "cum + indicative = purely WHEN",
      "freqTier": 1,
      "requires": [
        "verb.laudo.pres.act.ind"
      ],
      "examples": [
        {
          "id": "cum-t",
          "pieces": [
            {
              "t": "Cum",
              "role": "signal"
            },
            {
              "t": "id",
              "role": "plain"
            },
            {
              "t": "faciēbat",
              "role": "verb"
            },
            {
              "t": ", eum vīdī.",
              "role": "plain"
            }
          ],
          "translation": "When he was doing it, I saw him.",
          "source": "Wheelock 31 (pattern sentence)",
          "fakes": [
            {
              "pieceIdx": 2,
              "t": "faceret",
              "fromCell": "circum",
              "teaches": "faceret is SUBJUNCTIVE — that makes the clause circumstantial ('since/when, in those circumstances'), not a bare time-stamp.",
              "checked": true
            }
          ]
        }
      ]
    },
    {
      "id": "circum",
      "r": 1,
      "c": 0,
      "recipe": [
        {
          "t": "cum",
          "role": "signal"
        },
        {
          "t": "subjunctive",
          "role": "verb"
        }
      ],
      "tell": "cum + subjunctive = the circumstances in which — 'when' with atmosphere",
      "freqTier": 1,
      "requires": [
        "verb.laudo.impf.act.subj"
      ],
      "examples": [
        {
          "id": "cum-c",
          "pieces": [
            {
              "t": "Cum",
              "role": "signal"
            },
            {
              "t": "id",
              "role": "plain"
            },
            {
              "t": "faceret",
              "role": "verb"
            },
            {
              "t": ", eum vīdī.",
              "role": "plain"
            }
          ],
          "translation": "When he was doing it (in those circumstances), I saw him.",
          "source": "Wheelock 31 (pattern sentence)",
          "fakes": [
            {
              "pieceIdx": 2,
              "t": "faciēbat",
              "fromCell": "temporal",
              "teaches": "faciēbat is INDICATIVE — that flattens the clause to a plain time-stamp and loses the circumstantial colour.",
              "checked": true
            }
          ]
        }
      ]
    },
