          "role": "signal"
        },
        {
          "t": "present subjunctive",
          "role": "verb"
        }
      ],
      "tell": "a command in the subjunctive: 'let him…', 'let us…'",
      "freqTier": 1,
      "requires": [
        "verb.laudo.pres.act.subj"
      ],
      "examples": [
