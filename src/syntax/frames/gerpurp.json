          "role": "signal"
        },
        {
          "t": "gerundive in the accusative",
          "role": "verb"
        }
      ],
      "tell": "ad + gerundive = 'for the purpose of …-ing'",
      "freqTier": 1,
      "requires": [
        "ptcp.laudandus.sg"
      ],
      "examples": [
        {
          "id": "gp1",
          "pieces": [
            {
              "t": "Vēnit",
              "role": "plain"
            },
            {
              "t": "ad",
              "role": "signal"
            },
            {
              "t": "urbem videndam",
              "role": "verb"
            },
            {
              "t": ".",
              "role": "plain"
            }
          ],
          "translation": "He came to see the city.",
          "source": "Wheelock 39 (pattern sentence)",
          "fakes": [
